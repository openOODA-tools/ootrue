# Maintainer: openOODA-tools <ops@openooda.org>
pkgname=ootrue-bin
_pkgname=ootrue
pkgver=0.1.0
pkgrel=1
pkgdesc="Instant zero-byte binary returning exit status 0 without runtime overhead."
arch=('x86_64')
url="https://github.com/openOODA-tools/ootrue"
license=('Apache-2.0')
depends=('glibc')
provides=('ootrue')
conflicts=('ootrue')
source_x86_64=("${url}/releases/download/v${pkgver}/ootrue-linux-x86_64"
               "uninstall.sh::https://raw.githubusercontent.com/openOODA-tools/${_pkgname}/v${pkgver}/uninstall.sh")
sha256sums_x86_64=('SKIP'
                   'SKIP')

package() {
    install -Dm755 "${srcdir}/ootrue-linux-x86_64" "${pkgdir}/usr/bin/ootrue"
    install -Dm755 uninstall.sh "${pkgdir}/usr/bin/ootrue-uninstall"
}
